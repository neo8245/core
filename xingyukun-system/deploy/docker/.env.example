# 兴宇坤一一体机部署配置示例
# 复制此文件为 .env 并根据需要修改

# ========== 数据库配置 ==========
DB_USER=xingyukun
DB_PASSWORD=xingyukun@123
DB_NAME=xingyukun
DB_PORT=5432
SQL_ECHO=false

# ========== Redis 缓存配置 ==========
REDIS_PASSWORD=redis@123
REDIS_PORT=6379

# ========== 应用配置 ==========
APP_PORT=8000
WORKERS=4
DEBUG=false
ENVIRONMENT=production

# ========== JWT 配置 ==========
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_EXPIRE_MINUTES=60

# ========== 心链核配置 ==========
HEARTLINK_HOST=localhost
HEARTLINK_PORT=9999

# ========== 国产化配置 ==========
USE_NATIONAL_CRYPTO=true
USE_NATIONAL_DATABASE=false
USE_NATIONAL_OS=false

# ========== 合规配置 ==========
DATA_RESIDENCY=china
ENABLE_ENCRYPTION=true
ENABLE_AUDIT_LOG=true

# ========== CORS 配置 ==========
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ========== Nginx 配置 ==========
NGINX_PORT=80
NGINX_SSL_PORT=443
