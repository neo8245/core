# 应用配置
DEBUG=false
ENVIRONMENT=production

# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/xingyukun
SQL_ECHO=false

# Redis 缓存配置
CACHE_TYPE=memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT 配置
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_EXPIRE_MINUTES=60

# 心链核配置
HEARTLINK_HOST=localhost
HEARTLINK_PORT=9999
HEARTLINK_TIMEOUT=5

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WORKERS=4

# 国产化配置
USE_NATIONAL_CRYPTO=true
USE_NATIONAL_DATABASE=false  # 设为 true 使用金仓/达梦
USE_NATIONAL_OS=false         # 设为 true 使用 UOS/麒麟

# 合规配置
DATA_RESIDENCY=china
ENABLE_ENCRYPTION=true
ENABLE_AUDIT_LOG=true
